\\beta_{\\rm sh}\\approx 0.276\\,\\left(\\frac{L_{\\Theta}}{10^{35}\\,{\\rm erg}\\,{\\rm s }^{-1}\\,{\\rm Hz}^{-1}}\\right)^{1/34}\\left(\\frac{\\tau_{\\Theta}}{10^{8}}\\right) ^{-3/34}\\epsilon_{B,-1}^{-1/17}\\epsilon_{T}^{-15/34}, (A3)

n\\approx 1.3\\times 10^{5}\\,{\\rm cm}^{-3}\\,\\left(\\frac{\\nu_{\\Theta}}{1\\,{\\rm GHz }}\\right)^{2}\\left(\\frac{L_{\\Theta}}{10^{35}\\,{\\rm erg}\\,{\\rm s}^{-1}\\,{\\rm Hz }^{-1}}\\right)^{-5/17}\\left(\\frac{\\tau_{\\Theta}}{10^{8}}\\right)^{15/17} \\epsilon_{B,-1}^{-7/17}\\epsilon_{T}^{7/17}, (A4)

