$$
\mathrm{H}=-J\sum_{n}\mathbf{S}_{n}\cdot\mathbf{S}_{n+1}+\mathbf{d}_{\mathrm{DM}}\sum_{n}\mathbf{S}_{n}\mathbf{x}\mathbf{S}_{n+1}
$$
